# ---------------------------------------------------------------------------
# YouTube Insights MCP - configuration. Copy to .env and fill in.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# REQUIRED. Google Cloud API key with "YouTube Data API v3" enabled.
YTMCP_YOUTUBE_API_KEY=

# OAuth client (needed for YOUR channel's analytics and for google auth mode).
# Either point at the JSON you downloaded from Google Cloud...
YTMCP_GOOGLE_CLIENT_SECRETS_FILE=./secrets/google_client_secret.json
# ...or paste the two values:
# YTMCP_GOOGLE_CLIENT_ID=
# YTMCP_GOOGLE_CLIENT_SECRET=

# How MCP clients log in to THIS server:
#   token  = shared secret bearer token (Claude Code, scripts, your own server)   [default]
#   google = OAuth 2.1 "Sign in with Google" (Claude.ai / desktop custom connectors)
#   none   = no auth, only allowed on 127.0.0.1
YTMCP_AUTH_MODE=token

# token mode: one or more tokens, comma separated (32+ chars).
#   uv run youtube-insights-mcp gen-token
YTMCP_BEARER_TOKENS=

# google mode: your public https URL (no trailing slash), a random signing key,
# and the Google accounts allowed in (comma separated; empty = any Google account).
# Add  <PUBLIC_BASE_URL>/auth/callback  as an Authorized redirect URI on the OAuth client.
YTMCP_PUBLIC_BASE_URL=127.0.0.1
YTMCP_JWT_SIGNING_KEY=
YTMCP_ALLOWED_EMAILS=

# Network. Use 0.0.0.0 inside Docker / on a server.
YTMCP_HOST=127.0.0.1
YTMCP_PORT=8080
YTMCP_MCP_PATH=/mcp

# Storage (SQLite database + owner sign-in token).
YTMCP_DATA_DIR=./data

# Daily Data API budget this server may spend (Google default project quota is 10,000).
YTMCP_DAILY_QUOTA_UNITS=10000
# How long API responses are reused from the local cache.
YTMCP_CACHE_TTL_SECONDS=3600

# Allow editing titles/descriptions/tags of your videos (adds the youtube.force-ssl scope).
YTMCP_ENABLE_WRITE_TOOLS=false

YTMCP_LOG_LEVEL=INFO
